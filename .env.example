# Application Configuration
APP_NAME=MySQL-Iceberg-StarRocks Pipeline
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# MySQL Source Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name
MYSQL_CHARSET=utf8mb4

# StarRocks Target Database
STARROCKS_HOST=localhost
STARROCKS_PORT=9030
STARROCKS_USER=your_starrocks_user
STARROCKS_PASSWORD=your_starrocks_password
STARROCKS_DATABASE=default_catalog

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-iceberg-bucket
S3_WAREHOUSE_PATH=warehouse

# Apache Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=MySQL-Iceberg-Pipeline
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2

# Iceberg Configuration
ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_WAREHOUSE_PATH=s3a://your-iceberg-bucket/warehouse

# JDBC Configuration
JDBC_FETCH_SIZE=10000
JDBC_PARTITION_COLUMN=id
JDBC_NUM_PARTITIONS=10
JDBC_LOWER_BOUND=0
JDBC_UPPER_BOUND=1000000

# Pipeline Configuration
BATCH_SIZE=100000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5
PROCESS_TIMEOUT_SECONDS=3600

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
CORS_ORIGINS=["http://localhost:3000"]
